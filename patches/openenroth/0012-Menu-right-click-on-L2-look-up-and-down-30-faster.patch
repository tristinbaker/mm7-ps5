     int64_t dturn = gameTimer->dt().ticks() * pParty->_yawRotationSpeed * TrigLUT.uIntegerPi / 180 / Duration::TICKS_PER_REALTIME_SECOND;
     int dpitch = engine->config->settings.VerticalTurnSpeed.value();
     if (dpitch == 0)
-        dpitch = dturn / 2; // Smooth, the look actions then trigger every frame.
+        dpitch = std::lround(dturn * 0.65f); // Smooth, the look actions then trigger every frame.
     while (pPartyActionQueue->uNumActions) {
         switch (pPartyActionQueue->Next()) {
             case PARTY_FlyUp:
