diff --git a/src/Application/GameWindowHandler.cpp b/src/Application/GameWindowHandler.cpp
index 1668660..e00c4cb 100644
--- a/src/Application/GameWindowHandler.cpp
+++ b/src/Application/GameWindowHandler.cpp
@@ -462,7 +462,18 @@ bool GameWindowHandler::keyReleaseEvent(const PlatformKeyEvent *event) {
 }
 
 bool GameWindowHandler::mouseMoveEvent(const PlatformMouseEvent *event) {
-    OnMouseMove(render->MapToRender(event->pos), event->rel, event->buttons & BUTTON_LEFT, event->buttons & BUTTON_RIGHT);
+    Pointi position = render->MapToRender(event->pos);
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+    // The picture is letterboxed in the window. Keep the touchpad's pointer out of the bars, it would be invisible
+    // there, and moving it back would take a while.
+    Sizei renderSize = render->GetRenderDimensions();
+    Pointi clamped(std::clamp(position.x, 0, renderSize.w - 1), std::clamp(position.y, 0, renderSize.h - 1));
+    if (clamped != position) {
+        position = clamped;
+        window->warpMouse(render->MapToPresent(clamped));
+    }
+#endif
+    OnMouseMove(position, event->rel, event->buttons & BUTTON_LEFT, event->buttons & BUTTON_RIGHT);
     return false;
 }
 
