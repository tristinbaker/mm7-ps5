+
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+// The touchpad works like a laptop's: sliding a finger moves the pointer, pressing the pad clicks, and pressing it
+// with two fingers on it right-clicks. The pointer moves by the finger's travel, a full swipe across the pad moving it
+// across the whole window. It doesn't move while the pad is pressed, so clicks don't drag it off what they're aimed at.
+static constexpr float TOUCHPAD_POINTER_SPEED = 1.0f;
+static constexpr uint64_t TOUCHPAD_DOUBLE_CLICK_MS = 500; // SDL's defaults for mice.
+static constexpr float TOUCHPAD_DOUBLE_CLICK_RADIUS = 32.0f;
+
+void SdlEventLoop::dispatchTouchpadEvent(PlatformEventHandler *eventHandler, const SDL_ControllerTouchpadEvent *event) {
+    if (event->touchpad != 0 || event->finger < 0 || event->finger >= static_cast<int>(_touchpadFingerDown.size()))
+        return;
+
+    PlatformWindow *window = touchpadWindow();
+    if (!window)
+        return;
+
+    int finger = event->finger;
+    Vec2f pos(event->x, event->y);
+    Vec2f lastPos = _touchpadFingerPos[finger];
+    _touchpadFingerPos[finger] = pos;
+
+    switch (event->type) {
+    case SDL_CONTROLLERTOUCHPADDOWN:
+        _touchpadFingerDown[finger] = true;
+        if (_touchpadMovingFinger == -1)
+            _touchpadMovingFinger = finger;
+        if (_state->touchpadPointer().x < 0) {
+            Sizei size = window->size();
+            _state->setTouchpadPointer(Vec2f(size.w / 2.0f, size.h / 2.0f));
+        }
+        dispatchTouchpadMoveEvent(eventHandler, window, Vec2f()); // Lets the app show the pointer.
+        break;
+    case SDL_CONTROLLERTOUCHPADUP:
+        _touchpadFingerDown[finger] = false;
+        if (_touchpadMovingFinger == finger)
+            _touchpadMovingFinger = _touchpadFingerDown[1 - finger] ? 1 - finger : -1;
+        break;
+    case SDL_CONTROLLERTOUCHPADMOTION:
+        if (finger == _touchpadMovingFinger && _touchpadButton == BUTTON_NONE) {
+            Sizei size = window->size();
+            Vec2f rel((pos.x - lastPos.x) * size.w * TOUCHPAD_POINTER_SPEED, (pos.y - lastPos.y) * size.h * TOUCHPAD_POINTER_SPEED);
+            dispatchTouchpadMoveEvent(eventHandler, window, rel);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void SdlEventLoop::dispatchTouchpadMoveEvent(PlatformEventHandler *eventHandler, PlatformWindow *window, Vec2f rel) {
+    Sizei size = window->size();
+    Vec2f oldPointer = _state->touchpadPointer();
+    Vec2f pointer(std::clamp(oldPointer.x + rel.x, 0.0f, size.w - 1.0f), std::clamp(oldPointer.y + rel.y, 0.0f, size.h - 1.0f));
+    _state->setTouchpadPointer(pointer);
+
+    PlatformMouseEvent e;
+    e.type = EVENT_MOUSE_MOVE;
+    e.window = window;
+    e.button = BUTTON_NONE;
+    if (_touchpadButton != BUTTON_NONE)
+        e.buttons = _touchpadButton;
+    e.isDoubleClick = false;
+    e.pos = Pointi(pointer.x, pointer.y);
+    e.rel = Pointi(e.pos.x - static_cast<int>(oldPointer.x), e.pos.y - static_cast<int>(oldPointer.y));
+    dispatchEvent(eventHandler, &e);
+}
+
+void SdlEventLoop::dispatchTouchpadButtonEvent(PlatformEventHandler *eventHandler, bool pressed) {
+    PlatformWindow *window = touchpadWindow();
+    Vec2f pointer = _state->touchpadPointer();
+    if (!window || pointer.x < 0)
+        return; // The pointer hasn't been shown yet.
+
+    PlatformMouseEvent e;
+    e.window = window;
+    e.pos = Pointi(pointer.x, pointer.y);
+    e.isDoubleClick = false;
+
+    if (pressed) {
+        if (_touchpadButton != BUTTON_NONE)
+            return;
+
+        int fingers = std::count(_touchpadFingerDown.begin(), _touchpadFingerDown.end(), true);
+        _touchpadButton = fingers >= 2 ? BUTTON_RIGHT : BUTTON_LEFT;
+
+        uint64_t now = SDL_GetTicks64();
+        Vec2f moved = pointer - _touchpadLastPressPos;
+        if (_touchpadButton == _touchpadLastButton && now - _touchpadLastPressTicks <= TOUCHPAD_DOUBLE_CLICK_MS &&
+            std::hypot(moved.x, moved.y) <= TOUCHPAD_DOUBLE_CLICK_RADIUS) {
+            _touchpadClicks++;
+        } else {
+            _touchpadClicks = 1;
+        }
+        _touchpadLastButton = _touchpadButton;
+        _touchpadLastPressTicks = now;
+        _touchpadLastPressPos = pointer;
+
+        e.type = EVENT_MOUSE_BUTTON_PRESS;
+        e.button = _touchpadButton;
+        e.buttons = _touchpadButton;
+        e.isDoubleClick = _touchpadClicks % 2 == 0; // Every second click, like for mice in dispatchMouseButtonEvent.
+    } else {
+        if (_touchpadButton == BUTTON_NONE)
+            return;
+
+        e.type = EVENT_MOUSE_BUTTON_RELEASE;
+        e.button = _touchpadButton;
+        _touchpadButton = BUTTON_NONE;
+    }
+
+    dispatchEvent(eventHandler, &e);
+}
+
+PlatformWindow *SdlEventLoop::touchpadWindow() const {
+    // Gamepad events don't belong to a window. Apps with a touchpad mouse have a single one.
+    std::vector<uint32_t> ids = _state->allWindowIds();
+    return ids.empty() ? nullptr : _state->window(ids.front());
+}
+#endif
