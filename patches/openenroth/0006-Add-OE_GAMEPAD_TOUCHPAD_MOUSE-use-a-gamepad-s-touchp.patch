 #include "Library/Logger/LogCategory.h"
 #include "Library/Logger/LogEnums.h"
 
@@ -45,8 +46,20 @@ class SdlPlatformSharedState {
     std::vector<PlatformGamepad *> allGamepads() const;
     SdlGamepad *gamepad(SDL_JoystickID id) const;
 
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+    /**
+     * Pointer position of the gamepad touchpad mouse (see `SdlEventLoop`), in window coordinates. Negative until the
+     * touchpad is first used. Kept here so that `SdlWindow::warpMouse` moves it too.
+     */
+    Vec2f touchpadPointer() const { return _touchpadPointer; }
+    void setTouchpadPointer(Vec2f position) { _touchpadPointer = position; }
+#endif
+
  private:
     std::unordered_map<uint32_t, SdlWindow *> _windowById;
     std::unordered_map<SDL_JoystickID, std::unique_ptr<SdlGamepad>> _gamepadById;
     size_t _eventLoopCount = 0;
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+    Vec2f _touchpadPointer = {-1, -1};
+#endif
 };
