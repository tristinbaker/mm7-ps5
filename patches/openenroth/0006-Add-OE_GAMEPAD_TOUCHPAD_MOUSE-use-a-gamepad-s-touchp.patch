 #include "Library/Platform/Interface/PlatformEventLoop.h"
 #include "Library/Platform/Interface/PlatformEvents.h"
 
@@ -36,8 +40,25 @@ class SdlEventLoop: public PlatformEventLoop {
     void dispatchGamepadButtonEvent(PlatformEventHandler *eventHandler, const SDL_ControllerButtonEvent *event);
     void dispatchGamepadAxisEvent(PlatformEventHandler *eventHandler, const SDL_ControllerAxisEvent *event);
     void dispatchTextInputEvent(PlatformEventHandler *eventHandler, const SDL_TextInputEvent *event);
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+    void dispatchTouchpadEvent(PlatformEventHandler *eventHandler, const SDL_ControllerTouchpadEvent *event);
+    void dispatchTouchpadButtonEvent(PlatformEventHandler *eventHandler, bool pressed);
+    void dispatchTouchpadMoveEvent(PlatformEventHandler *eventHandler, PlatformWindow *window, Vec2f rel);
+    PlatformWindow *touchpadWindow() const;
+#endif
 
  private:
     SdlPlatformSharedState *_state = nullptr;
     bool _quitRequested = false;
+#ifdef OE_GAMEPAD_TOUCHPAD_MOUSE
+    // Gamepad touchpad mouse, see dispatchTouchpadEvent. The pointer position itself is in _state.
+    std::array<bool, 2> _touchpadFingerDown = {};
+    std::array<Vec2f, 2> _touchpadFingerPos = {}; // Last position of each finger on the touchpad, in [0, 1].
+    int _touchpadMovingFinger = -1; // The finger that moves the pointer, -1 if none is down.
+    PlatformMouseButton _touchpadButton = BUTTON_NONE; // Button that the current touchpad press is holding down.
+    PlatformMouseButton _touchpadLastButton = BUTTON_NONE;
+    uint64_t _touchpadLastPressTicks = 0;
+    Vec2f _touchpadLastPressPos;
+    int _touchpadClicks = 0;
+#endif
 };
