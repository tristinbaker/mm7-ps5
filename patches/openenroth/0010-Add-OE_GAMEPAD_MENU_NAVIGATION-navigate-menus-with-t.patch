diff --git a/src/Io/MenuNavigation.cpp b/src/Io/MenuNavigation.cpp
new file mode 100644
index 0000000..510c98b
--- /dev/null
+++ b/src/Io/MenuNavigation.cpp
@@ -0,0 +1,128 @@
+#include "MenuNavigation.h"
+
+#include <cstdlib>
+#include <limits>
+
+#include "Engine/Graphics/Renderer/Renderer.h"
+#include "Engine/Objects/Chest.h"
+#include "Engine/Party.h"
+#include "Engine/Tables/ChestTable.h"
+
+#include "GUI/GUIButton.h"
+#include "GUI/GUIWindow.h"
+#include "GUI/UI/UICharacter.h"
+#include "GUI/UI/UIChest.h"
+#include "GUI/UI/UISpell.h"
+
+#include "Library/Geometry/Rect.h"
+
+static constexpr int CELL_SIZE = 32;
+static constexpr Pointi CHARACTER_INVENTORY_TOP_LEFT = {14, 17};
+static constexpr Sizei CHARACTER_INVENTORY_SIZE = {14, 9};
+
+// Whether the window's own keyboard navigation (GUIWindow::setKeyboardControlGroup) works with a gamepad: it shows
+// what's selected, and the dialog select binding isn't also one of the window's hotkeys. Then the menu navigation
+// stays out of the way - party creation, NPC and house dialogues. The game menu shows no selection and loses it to
+// the mouse, and the spellbook can only step down its list.
+static bool hasOwnNavigation(const GUIWindow *window) {
+    return window->receives_keyboard_input && window->pNumPresenceButton > 0 &&
+           window->eWindowType != WINDOW_GAME_MENU && window->eWindowType != WINDOW_SPELL_BOOK;
+}
+
+// Windows the menu navigation works in, topmost first. Empty if there are none, or one of them navigates itself.
+static std::vector<GUIWindow *> menuWindows() {
+    if (pGUIWindow_CastTargetedSpell)
+        return {pGUIWindow_CastTargetedSpell.get()}; // Like clicks, see Io::Mouse::UI_OnMouseLeftClick.
+
+    std::vector<GUIWindow *> result;
+    Recti screen(Pointi(0, 0), render->GetRenderDimensions());
+    for (GUIWindow *window : lWindowList) {
+        if (window == pPrimaryWindow.get())
+            break; // The game's own interface isn't a menu.
+        if (hasOwnNavigation(window))
+            return {};
+        result.push_back(window);
+        if (window->frameRect == screen)
+            break; // Covers everything below.
+    }
+    return result;
+}
+
+static void addGrid(std::vector<Pointi> *targets, Pointi topLeft, Sizei size) {
+    for (int y = 0; y < size.h; y++)
+        for (int x = 0; x < size.w; x++)
+            targets->push_back(topLeft + Pointi(x * CELL_SIZE + CELL_SIZE / 2, y * CELL_SIZE + CELL_SIZE / 2));
+}
+
+std::vector<Pointi> Io::menuNavigationTargets() {
+    std::vector<Pointi> result;
+    Recti screen(Pointi(0, 0), render->GetRenderDimensions());
+    for (GUIWindow *window : menuWindows()) {
+        for (GUIButton *button : window->vButtons) {
+            if (button->rect.w <= 0 || button->rect.h <= 0)
+                continue; // Hotkey-only button.
+
+            // Item areas are single big buttons, move between their cells and items instead.
+            switch (button->msg) {
+            case UIMSG_InventoryLeftClick:
+                if (current_character_screen_window == WINDOW_CHARACTER_INVENTORY || current_screen_type == SCREEN_CHEST_INVENTORY)
+                    addGrid(&result, CHARACTER_INVENTORY_TOP_LEFT, CHARACTER_INVENTORY_SIZE);
+                continue;
+            case UIMSG_CHEST_ClickItem:
+                if (pGUIWindow_CurrentChest) {
+                    const Chest &chest = vChests[pGUIWindow_CurrentChest->chestId()];
+                    addGrid(&result, chestTable[chest.chestTypeId].inventoryOffset, chest.inventory.gridSize());
+                }
+                continue;
+            case UIMSG_ClickPaperdoll:
+                for (Pointi point : equipmentHitMap.visiblePoints(-1))
+                    result.push_back(point);
+                if (pParty->pPickedItem.itemId != ITEM_NULL)
+                    result.push_back(button->rect.center()); // Anywhere on the doll equips.
+                continue;
+            default:
+                break;
+            }
+
+            if (screen.contains(button->rect.center()))
+                result.push_back(button->rect.center());
+        }
+    }
+    return result;
+}
+
+std::optional<Pointi> Io::menuNavigationStep(const std::vector<Pointi> &targets, Pointi from, Pointi direction) {
+    std::optional<Pointi> best, nearest;
+    long bestScore = std::numeric_limits<long>::max(), nearestDistance = std::numeric_limits<long>::max();
+    bool onTarget = false;
+    for (Pointi target : targets) {
+        Pointi offset = target - from;
+        long along = offset.x * direction.x + offset.y * direction.y;
+        long across = std::abs(offset.x * direction.y - offset.y * direction.x);
+        onTarget |= along == 0 && across == 0;
+
+        long distance = std::abs(offset.x) + std::abs(offset.y);
+        if (distance < nearestDistance) {
+            nearestDistance = distance;
+            nearest = target;
+        }
+
+        long score = along + 2 * across; // Prefer what's in line over what's closer but off to the side.
+        if (along > 0 && score < bestScore) {
+            bestScore = score;
+            best = target;
+        }
+    }
+
+    if (!best && !onTarget)
+        return nearest;
+    return best;
+}
+
+bool Io::isMenuNavigationClickable(Pointi point) {
+    for (GUIWindow *window : menuWindows())
+        for (GUIButton *button : window->vButtons)
+            if (button->rect.w > 0 && button->rect.h > 0 && button->rect.contains(point))
+                return true;
+    return false;
+}
diff --git a/src/Io/MenuNavigation.h b/src/Io/MenuNavigation.h
new file mode 100644
index 0000000..36f3d58
--- /dev/null
+++ b/src/Io/MenuNavigation.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <optional>
+#include <vector>
+
+#include "Library/Geometry/Point.h"
+
+// Gamepad navigation in menus with the mouse cursor (OE_GAMEPAD_MENU_NAVIGATION): the d-pad moves the cursor to the
+// nearest thing to click in its direction, and a gamepad button clicks where the cursor is. Menus are the windows open
+// over the game's own interface, or all windows when there is none (the main menu), except that menus with a working
+// keyboard navigation of their own (party creation, dialogues) keep it. Positions are in render coordinates.
+namespace Io {
+
+/**
+ * @return                              Points the cursor can move to in the open menus: the middle of every button,
+ *                                      inventory and chest cells, equipped items. Empty if no menu is open.
+ */
+std::vector<Pointi> menuNavigationTargets();
+
+/**
+ * @param targets                       Result of `menuNavigationTargets`.
+ * @param from                          Cursor position.
+ * @param direction                     One of (0, -1), (0, 1), (-1, 0), (1, 0).
+ * @return                              The target to move the cursor to: the nearest one in `direction`, preferring
+ *                                      ones in line with `from`. If there's none and `from` isn't on a target, the
+ *                                      nearest target. Otherwise `std::nullopt`.
+ */
+std::optional<Pointi> menuNavigationStep(const std::vector<Pointi> &targets, Pointi from, Pointi direction);
+
+/**
+ * @return                              Whether a click at `point` would land on something in the open menus.
+ */
+bool isMenuNavigationClickable(Pointi point);
+
+} // namespace Io
