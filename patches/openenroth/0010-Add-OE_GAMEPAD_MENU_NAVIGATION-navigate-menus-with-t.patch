diff --git a/src/Engine/HitMap.h b/src/Engine/HitMap.h
index ffb9524..fcf9191 100644
--- a/src/Engine/HitMap.h
+++ b/src/Engine/HitMap.h
@@ -74,6 +74,43 @@ class HitMap {
         return defaultValue;
     }
 
+    /**
+     * @param defaultValue              Value to leave out.
+     * @return                          For every other value that's visible somewhere, a point where `query`
+     *                                  returns it, as close to the middle of its image as there is one.
+     */
+    std::vector<Pointi> visiblePoints(T defaultValue = {}) const {
+        std::vector<T> values;
+        std::vector<std::pair<Pointi, int>> best; // Point and its squared distance from the image center, per value.
+        for (const Entry &entry : _entries) {
+            if (entry.value == defaultValue)
+                continue;
+
+            Recti rect(entry.position, entry.image->size());
+            Pointi center = rect.center();
+            for (int y = rect.y; y < rect.y + rect.h; y += 2) {
+                for (int x = rect.x; x < rect.x + rect.w; x += 2) {
+                    Pointi point(x, y);
+                    if (query(point, defaultValue) != entry.value)
+                        continue;
+                    int distance = (x - center.x) * (x - center.x) + (y - center.y) * (y - center.y);
+                    auto pos = std::find(values.begin(), values.end(), entry.value);
+                    if (pos == values.end()) {
+                        values.push_back(entry.value);
+                        best.emplace_back(point, distance);
+                    } else if (distance < best[pos - values.begin()].second) {
+                        best[pos - values.begin()] = {point, distance};
+                    }
+                }
+            }
+        }
+
+        std::vector<Pointi> result;
+        for (const auto &[point, distance] : best)
+            result.push_back(point);
+        return result;
+    }
+
  private:
     struct Entry {
         Pointi position;
