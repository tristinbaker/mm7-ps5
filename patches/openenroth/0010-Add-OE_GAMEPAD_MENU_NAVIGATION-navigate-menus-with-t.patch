 bool GameWindowHandler::gamepadKeyPressEvent(const PlatformGamepadKeyEvent *event) {
+#ifdef OE_GAMEPAD_MENU_NAVIGATION
+    if (menuNavigationKeyPress(event->key))
+        return true; // Not for KeyboardController either, these buttons mean other things in the game.
+#endif
     handleKeyPress(event->key, 0, false);
     return false;
 }
 
 bool GameWindowHandler::gamepadKeyReleaseEvent(const PlatformGamepadKeyEvent *event) {
+#ifdef OE_GAMEPAD_MENU_NAVIGATION
+    if (menuNavigationKeyRelease(event->key))
+        return true;
+#endif
     handleKeyRelease(event->key);
     return false;
 }
 
+#ifdef OE_GAMEPAD_MENU_NAVIGATION
+// In menus, the dialog d-pad bindings move the mouse cursor between the things to click (see Io/MenuNavigation.h),
+// the dialog select binding clicks and this button right-clicks, for item info and the like. The clicks only happen
+// over something to click, elsewhere the buttons keep doing what they do, like the menus' own hotkeys.
+static constexpr PlatformKey MENU_RIGHT_CLICK_KEY = PlatformKey::KEY_GAMEPAD_X;
+static constexpr int64_t MENU_DOUBLE_CLICK_MS = 500;
+
+bool GameWindowHandler::menuNavigationKeyPress(PlatformKey key) {
+    if (!mouse || pArcomageGame->_gameInProgress || currently_selected_action_for_binding != INPUT_ACTION_INVALID)
+        return false;
+
+    Pointi direction;
+    if (keyboardActionMapping->isBound(INPUT_ACTION_DIALOG_UP, key)) {
+        direction = Pointi(0, -1);
+    } else if (keyboardActionMapping->isBound(INPUT_ACTION_DIALOG_DOWN, key)) {
+        direction = Pointi(0, 1);
+    } else if (keyboardActionMapping->isBound(INPUT_ACTION_DIALOG_LEFT, key)) {
+        direction = Pointi(-1, 0);
+    } else if (keyboardActionMapping->isBound(INPUT_ACTION_DIALOG_RIGHT, key)) {
+        direction = Pointi(1, 0);
+    }
+
+    if (direction != Pointi()) {
+        std::vector<Pointi> targets = Io::menuNavigationTargets();
+        if (targets.empty())
+            return false; // No menu open, the d-pad acts in the game.
+        if (std::optional<Pointi> target = Io::menuNavigationStep(targets, mouse->position(), direction)) {
+            mouse->warpMouse(*target);
+            OnMouseMove(*target, Pointi(), false, false);
+        }
+        return true;
+    }
+
+    PlatformMouseButton button = BUTTON_NONE;
+    if (keyboardActionMapping->isBound(INPUT_ACTION_DIALOG_PRESS, key)) {
+        button = BUTTON_LEFT;
+    } else if (key == MENU_RIGHT_CLICK_KEY) {
+        button = BUTTON_RIGHT;
+    }
+    if (button == BUTTON_NONE || _menuClickKey != PlatformKey::KEY_NONE || !Io::isMenuNavigationClickable(mouse->position()))
+        return false;
+
+    Pointi position = mouse->position();
+    _menuClickKey = key;
+    _menuClickButton = button;
+    if (button == BUTTON_RIGHT) {
+        OnMouseRightClick(position);
+        return true;
+    }
+
+    // Double clicks like dispatchMouseButtonEvent in the SDL backends: every second click in a row.
+    int64_t now = platform->tickCount();
+    bool again = now - _menuLastClickTime <= MENU_DOUBLE_CLICK_MS && position == _menuLastClickPosition;
+    _menuClicks = again ? _menuClicks + 1 : 1;
+    _menuLastClickTime = now;
+    _menuLastClickPosition = position;
+    if (_menuClicks % 2 == 0) {
+        OnMouseLeftDoubleClick(position);
+    } else {
+        OnMouseLeftClick(position, false);
+    }
+    return true;
+}
+
+bool GameWindowHandler::menuNavigationKeyRelease(PlatformKey key) {
+    if (key == PlatformKey::KEY_NONE || key != _menuClickKey)
+        return false;
+
+    _menuClickKey = PlatformKey::KEY_NONE;
+    if (_menuClickButton == BUTTON_LEFT) {
+        OnMouseLeftUp();
+    } else {
+        OnMouseRightUp();
+    }
+    return true;
+}
+#endif
+
 bool GameWindowHandler::gamepadAxisEvent(const PlatformGamepadAxisEvent *event) {
     PlatformKey key = event->axis;
     float value = event->value;
