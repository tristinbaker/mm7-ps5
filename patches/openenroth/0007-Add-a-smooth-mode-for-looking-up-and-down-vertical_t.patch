From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tristin Baker <tristinbaker@protonmail.com>
Date: Tue, 20 Oct 2026 14:33:08 -0400
Subject: [PATCH] Add a smooth mode for looking up and down:
 vertical_turn_speed = 0

Looking up and down moves the view in steps of vertical_turn_speed, repeated with the keyboard's repeat delay.
That's how the original game works, but with a gamepad stick it's jerky. With 0, like turn_speed's smooth mode,
the look actions trigger every frame while held and move the view at half the turn speed.
---
 src/Application/GameConfig.h    | 6 ++++--
 src/Engine/Graphics/Indoor.cpp  | 7 +++++--
 src/Engine/Graphics/Outdoor.cpp | 7 +++++--
 src/Io/KeyboardInputHandler.cpp | 6 +++++-
 4 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/src/Application/GameConfig.h b/src/Application/GameConfig.h
index a487ab1..e0e863e 100644
--- a/src/Application/GameConfig.h
+++ b/src/Application/GameConfig.h
@@ -635,7 +635,9 @@ class GameConfig : public Config {
                          "Discrete turn speed, use 0 for smooth, 16 for 64 degrees turn, 32 for 128 degrees turn, etc. "
                          "Only smooth is usable on modern machines."};
 
-        Int VerticalTurnSpeed = {this, "vertical_turn_speed", 25, &ValidateVerticalTurnSpeed, "Discrete vertical turn speed."};
+        Int VerticalTurnSpeed = {this, "vertical_turn_speed", 25, &ValidateVerticalTurnSpeed,
+                                 "Discrete vertical turn speed, use 0 for smooth (looking up and down at half the turn "
+                                 "speed for as long as the key is held)."};
 
         // TODO(captainurist): move to [audio]?
         Bool WalkSound = {this, "walk_sound", true, "Enable footsteps sound when walking."};
@@ -657,7 +659,7 @@ class GameConfig : public Config {
             return std::clamp(level, 0, 9);
         }
         static int ValidateVerticalTurnSpeed(int speed) {
-            return std::clamp(speed, 1, 128);
+            return std::clamp(speed, 0, 128);
         }
         static int ValidateTurnSpeed(int speed) {
             return std::clamp(speed, 0, 1024);
