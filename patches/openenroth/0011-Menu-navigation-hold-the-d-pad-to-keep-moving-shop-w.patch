+static void moveCursor(const std::vector<Pointi> &targets, Pointi direction) {
+    if (std::optional<Pointi> target = Io::menuNavigationStep(targets, mouse->position(), direction)) {
+        mouse->warpMouse(*target);
+        mouse->setPosition(*target);
+    }
+}
+
+bool Io::pressMenuNavigation(Pointi direction) {
+    std::vector<Pointi> targets = menuNavigationTargets();
+    if (targets.empty())
+        return false;
+
+    moveCursor(targets, direction);
+    heldDirection = direction;
+    nextRepeatTime = platform->tickCount() + REPEAT_DELAY_MS;
+    return true;
+}
+
+void Io::releaseMenuNavigation(Pointi direction) {
+    if (direction == heldDirection)
+        heldDirection = Pointi();
+}
+
+void Io::updateMenuNavigation() {
+    if (heldDirection == Pointi() || platform->tickCount() < nextRepeatTime)
+        return;
+
+    std::vector<Pointi> targets = menuNavigationTargets();
+    if (targets.empty()) {
+        heldDirection = Pointi(); // The menu closed.
+        return;
+    }
+    moveCursor(targets, heldDirection);
+    nextRepeatTime = platform->tickCount() + REPEAT_INTERVAL_MS;
+}
