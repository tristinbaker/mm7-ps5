From 12f3a71422c31fcb7c342cbdc483da2d97d1ce8c Mon Sep 17 00:00:00 2001
From: Tristin Baker <tristinbaker@protonmail.com>
Date: Tue, 20 Oct 2026 13:52:43 -0400
Subject: [PATCH] Add OE_PRESENT_WITH_DRAW: present the scaled frame with a
 textured quad

flushAndScale scales the render target to the window with glBlitFramebuffer. The PS5 homebrew OpenGL driver
only blits on the GPU between matching formats, so there it read the 640x480 target back and scaled it on the
CPU every frame, which held the game at about 10 fps. With the option on, the target is drawn as a fullscreen
quad instead, which stays on the GPU everywhere. The GL state is left as the blit path leaves it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                                |  5 +++
 resources/CMakeLists.txt                      |  2 +
 resources/shaders/glpresent.frag              | 11 +++++
 resources/shaders/glpresent.vert              |  9 ++++
 .../Graphics/Renderer/OpenGLRenderer.cpp      | 45 ++++++++++++++++++-
 src/Engine/Graphics/Renderer/OpenGLRenderer.h |  5 +++
 6 files changed, 76 insertions(+), 1 deletion(-)
 create mode 100644 resources/shaders/glpresent.frag
 create mode 100644 resources/shaders/glpresent.vert

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 59e26fd..326e3b6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,6 +42,7 @@ set(OE_DISTRIBUTION_BUILD OFF CACHE BOOL "Specify that this is a build for distr
 set(OE_USE_SANITIZERS "" CACHE STRING "Sanitizers to build with, passed on to -fsanitize=. Empty string disables sanitizers.")
 set(OE_GL33 OFF CACHE BOOL "Request an OpenGL 3.3 core context and GLSL 330 shaders instead of OpenGL 4.1.")
 set(OE_USE_SDL2 OFF CACHE BOOL "Use SDL2 platform backend instead of SDL3, for platforms where only SDL2 is available.")
+set(OE_PRESENT_WITH_DRAW OFF CACHE BOOL "Present the scaled frame by drawing a quad instead of glBlitFramebuffer, for drivers that blit on the CPU.")
 
 if(OE_DISTRIBUTION_BUILD)
     add_compile_definitions(OE_DISTRIBUTION_BUILD)
@@ -51,6 +52,10 @@ if(OE_GL33)
     add_compile_definitions(OE_GL33)
 endif()
 
+if(OE_PRESENT_WITH_DRAW)
+    add_compile_definitions(OE_PRESENT_WITH_DRAW)
+endif()
+
 if(OE_USE_SDL2)
     add_compile_definitions(OE_USE_SDL2) # Selects ImGui SDL2 backend in the code that calls into it directly.
 endif()
