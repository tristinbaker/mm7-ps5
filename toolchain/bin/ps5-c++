#!/bin/sh
# C++ compiler for PS5 native-title code: the native app template's target wrapper, driven by LLVM 21.
root=$(cd -- "$(dirname -- "$0")/../.." && pwd)
llvm=${LLVM21:-/usr/lib/llvm21}
export PS5_PAYLOAD_SDK="$root/deps/ps5-native-app-boilerplate/.deps/native/ps5-payload-sdk"
export PS5_CLANG="$llvm/bin/clang++"
exec sh "$root/deps/ps5-native-app-boilerplate/tooling/prospero-clang18" "$@"
